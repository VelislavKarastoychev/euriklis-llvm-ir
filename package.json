{
  "name": "@euriklis/llvm-ir",
  "version": "0.1.0",
  "description": "TypeScript LLVM IR builder with support for multiple architectures (GPU: CUDA, AMD, Intel; CPU: x86-64, ARM, RISC-V; Web: WebAssembly)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dialects/nvptx": {
      "import": "./dist/dialects/nvptx/index.js",
      "types": "./dist/dialects/nvptx/index.d.ts"
    },
    "./dialects/amdgpu": {
      "import": "./dist/dialects/amdgpu/index.js",
      "types": "./dist/dialects/amdgpu/index.d.ts"
    },
    "./dialects/spirv": {
      "import": "./dist/dialects/spirv/index.js",
      "types": "./dist/dialects/spirv/index.d.ts"
    },
    "./dialects/arm": {
      "import": "./dist/dialects/arm/index.js",
      "types": "./dist/dialects/arm/index.d.ts"
    },
    "./dialects/riscv": {
      "import": "./dist/dialects/riscv/index.js",
      "types": "./dist/dialects/riscv/index.d.ts"
    },
    "./dialects/wasm": {
      "import": "./dist/dialects/wasm/index.js",
      "types": "./dist/dialects/wasm/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build:tsc",
    "build:tsc": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "llvm",
    "llvm-ir",
    "compiler",
    "codegen",
    "gpu",
    "cuda",
    "nvptx",
    "amdgpu",
    "spirv",
    "opencl",
    "arm",
    "aarch64",
    "riscv",
    "wasm",
    "webassembly",
    "x86-64",
    "typescript",
    "code-generation",
    "multi-architecture"
  ],
  "author": "Velislav Simov Karastoychev <vskarastoychev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VelislavKarastoychev/euriklis-llvm-ir.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
